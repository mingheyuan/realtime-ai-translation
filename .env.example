RT_TRANSLATION_LISTEN=127.0.0.1:8765
RT_TRANSLATION_SEGMENT_IDLE_MS=900
RT_TRANSLATION_MT_DEVICE=cpu

# Set to 1 to test the UI without installing MarianMT.
RT_TRANSLATION_FAKE_TRANSLATION=0

# Optional OpenAI-compatible final-pass translator.
RT_TRANSLATION_LLM_ENABLED=0
RT_TRANSLATION_LLM_BASE_URL=https://api.openai.com/v1
RT_TRANSLATION_LLM_API_KEY=
RT_TRANSLATION_LLM_MODEL=
RT_TRANSLATION_LLM_TIMEOUT=20
