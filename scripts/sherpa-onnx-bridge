#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "$0")/.." && pwd)"
python_path="${RT_TRANSLATION_PYTHON:-$project_dir/.venv/bin/python}"

if [[ ! -x "$python_path" ]]; then
  echo "Sherpa-ONNX Python runtime is missing; run ./scripts/setup-sherpa-onnx.sh" >&2
  exit 1
fi

exec "$python_path" "$project_dir/bridges/sherpa-onnx/bridge.py" "$@"
